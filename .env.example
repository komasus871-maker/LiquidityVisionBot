BOT_TOKEN=replace_with_botfather_token
BOT_MODE=webhook
WEBHOOK_BASE_URL=https://YOUR-SERVICE.onrender.com

# Persistent production database. Required on Render when
# REQUIRE_PERSISTENT_DB=true.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PGSSLMODE=require
REQUIRE_PERSISTENT_DB=true
DB_CONNECT_TIMEOUT=15

# Free Render cannot run loops while asleep. Configure an external cron to:
# GET /internal/monitor?token=YOUR_SECRET every 5 minutes.
MONITOR_CRON_SECRET=replace_with_a_long_random_secret

SIGNAL_CHECK_INTERVAL=60
OBSERVATION_CHECK_INTERVAL=300
WATCHLIST_CHECK_INTERVAL=300
WATCHLIST_MONITOR_CONCURRENCY=4
WATCHLIST_SCORE_DELTA=12
WATCHLIST_READINESS_DELTA=12
ANALYSIS_CONCURRENCY=2
SCANNER_CONCURRENCY=4
SCANNER_CACHE_TTL=30

PREMIUM_STARS=199
PREMIUM_DAYS=30
DATA_DIR=data

# Trade Lifecycle 2.0
AUTO_BREAK_EVEN_AFTER_TP1=true
TRADE_PROGRESS_INTERVAL=900
TRADE_PROGRESS_STEP=20

# v7.2 production diagnostics
APP_VERSION=9.9.18
ADMIN_IDS=
SCHEMA_VERSION=1
WORKER_STALE_AFTER=900
LOG_LEVEL=INFO

# v9.0 paper copy execution
COPY_EXECUTION_INTERVAL=60
COPY_EXECUTION_ENABLED=true
COPY_EXECUTION_LEASE_SECONDS=180
PAPER_MIN_NOTIONAL_USDT=5
PAPER_QUANTITY_DECIMALS=8

# v9.9.17 leakage-controlled edge discovery and PAPER/SHADOW Strategy Lab.
RESEARCH_INTERVAL_SECONDS=300
RESEARCH_BATCH_LIMIT=200
RESEARCH_MIN_SAMPLES=20
EDGE_MIN_SAMPLES=20
EDGE_MODERATE_SAMPLES=50
EDGE_HIGH_SAMPLES=100
EDGE_BOOTSTRAP_SAMPLES=500
EDGE_BOOTSTRAP_MAX_N=500
EDGE_COMBINATION_MIN_SAMPLES=20
EDGE_COMBINATION_MIN_SUPPORT=0.05
EDGE_MAX_COMBINATIONS=120
EDGE_MAX_NEW_HYPOTHESES=10
EDGE_FORWARD_MIN_SAMPLES=30
EDGE_HYPOTHESIS_STALE_DAYS=90
EDGE_WALK_FORWARD_MIN_TRAIN=60
EDGE_WALK_FORWARD_VALIDATION_SIZE=20
EDGE_HISTORY_LIMIT=5000
EDGE_AI_COMPARISON_LIMIT=500
EDGE_RANK_OVERLAP_MINUTES=60
RESEARCH_ESTIMATED_EXECUTION_COST_PCT=0.19
SCALPING_MIN_SAMPLES=100
SCALPING_MIN_GROSS_COST_MULTIPLE=1.5
SCALPING_TAKER_FEE_PCT=0.05
SCALPING_SPREAD_PCT=0.02
SCALPING_SLIPPAGE_PCT=0.03
SCALPING_LATENCY_PENALTY_PCT=0.01

# v9.9.18 bounded public-market microstructure research. This has no order or
# execution authority. Keep false locally unless continuous public API sampling
# is intended; Render enables the bounded observer explicitly.
MICROSTRUCTURE_COLLECTION_ENABLED=false
MICROSTRUCTURE_INTERVAL_SECONDS=60
MICROSTRUCTURE_MAX_SYMBOLS=8
MICROSTRUCTURE_SAMPLES_PER_SYMBOL=5
MICROSTRUCTURE_SAMPLE_SPACING_MS=400
MICROSTRUCTURE_MAX_LEVELS=50
REVERSAL_EXTREME_MOVE_PCT=12

# v9.8.2 Multi-Exchange Foundation (read-only; use testnet first)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW=5000
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BYBIT_RECV_WINDOW=5000
EXCHANGE_DEFAULT=okx
EXCHANGE_HTTP_TIMEOUT=10
EXCHANGE_CONNECT_TIMEOUT=5
EXCHANGE_READ_TIMEOUT=12
EXCHANGE_MAX_ATTEMPTS=3
EXCHANGE_RETRY_BACKOFF=0.35
EXCHANGE_SYMBOL_CACHE_TTL=300

# OKX V5 (read-only adapter; demo mode uses x-simulated-trading: 1)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=true

# BingX USDT-M read-only adapter
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_DEMO=true
BINGX_RECV_WINDOW=5000
# v9.9.11 BingX certification. BINGX_DEMO=true selects prod-vst explicitly.
BINGX_PRODUCTION_ADAPTER_ALLOWED=false
BINGX_VST_CERTIFICATION_ENABLED=false
BINGX_LIVE_CERTIFICATION_ENVIRONMENT=prod-vst
BINGX_CERTIFICATION_TTL_HOURS=24
BINGX_MAX_SERVER_DRIFT_MS=1500
BINGX_CERTIFICATION_SYMBOL=BTCUSDT
BINGX_CERTIFICATION_QUANTITY=0.001
# Used only to validate minimum notional and normalize the certification sample.
BINGX_CERTIFICATION_REFERENCE_PRICE=60000

# v9.8.7 authenticated snapshot + execution preflight safety.
# LIVE stays locked unless explicitly enabled in a future controlled release.
EXCHANGE_OPERATION_TIMEOUT=25
LIVE_EXECUTION_ENABLED=false
# Explicit mode: DISABLED, PAPER (default), SHADOW, LIVE_DRY_RUN, or LIVE.
EXECUTION_MODE=PAPER
# Must identify production correctly before LIVE readiness can pass.
ENVIRONMENT=production
EXECUTION_REQUIRE_DEMO=true
EXECUTION_MAX_NOTIONAL_USDT=100
EXECUTION_MAX_LEVERAGE=5
EXECUTION_MAX_OPEN_POSITIONS=3
EXECUTION_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT

# v9.8.8 autonomous demo execution. Live execution is still hard-blocked.
DEMO_EXECUTION_ENABLED=false
EXECUTION_AUDIT_PATH=data/execution_audit.jsonl
EXECUTION_CIRCUIT_FAILURES=3
EXECUTION_CIRCUIT_COOLDOWN=60

# v9.9.0 Multi-User Exchange Accounts
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXCHANGE_CREDENTIALS_MASTER_KEY=
# Keep false until live trading has a dedicated confirmation and risk workflow.
ALLOW_USER_LIVE_CONNECTIONS=false
# v9.9.8 portfolio admission source: LEGACY, SHADOW (default), or UNIFIED.
# SHADOW computes both models and fails closed on unresolved risk.
PORTFOLIO_ACCOUNTING_SOURCE=SHADOW
# Truth-preserving legacy catalog rows processed per startup. Bounded to 1..5000.
HISTORICAL_MIGRATION_BATCH_SIZE=500
# Maximum Telegram updates retained as in-process background work. Requests
# above the limit receive 503 so Telegram retries instead of losing the update.
WEBHOOK_MAX_ACTIVE_UPDATES=100

# Advisory intelligence foundation. AI_GATED remains fail-closed.
AI_TRADING_MODE=AI_OFF
AI_PROVIDER=disabled
AI_PROVIDER_PROTOCOL=responses
AI_STRUCTURED_OUTPUT_MODE=json_schema
AI_STRICT_SCHEMA_REQUIRED=true
AI_ALLOW_JSON_OBJECT_FALLBACK=false
AI_SCHEMA_VERSION=ai-decision-v2
AI_MODEL=gpt-5.6-terra
AI_MODEL_VERSION=gpt-5.6-terra
AI_PROVIDER_ENDPOINT=https://api.openai.com/v1/responses
# Configure AI_PROVIDER_API_KEY only as a Render secret; never commit it.
AI_REQUEST_TIMEOUT_SECONDS=45
AI_PROVIDER_MAX_RESPONSE_BYTES=1000000
AI_PROVIDER_MAX_ATTEMPTS=1
AI_MAX_DAILY_REQUESTS_PER_USER=10
AI_MAX_DAILY_REQUESTS=100
AI_MAX_DAILY_COST_USD=2
AI_MAX_TOKENS=1200
AI_MAX_CONCURRENCY=1
AI_OBSERVE_QUEUE_DEPTH=10
AI_OBSERVE_DROP_AUDIT_LIMIT=25
AI_SHADOW_INTERVAL=60
AI_CONTEXT_MAX_AGE_SECONDS=300
AI_CONTEXT_MAX_CHARS=30000
AI_CIRCUIT_BREAKER_FAILURES=5
AI_CIRCUIT_BREAKER_SECONDS=300
AI_OBSERVATION_CACHE_ENABLED=true
AI_OBSERVATION_CACHE_TTL_SECONDS=180
AI_INPUT_COST_PER_MILLION_USD=2.50
AI_OUTPUT_COST_PER_MILLION_USD=15.00
AI_CACHED_INPUT_COST_PER_MILLION_USD=0.25
AI_CACHE_WRITE_COST_PER_MILLION_USD=3.125
AI_PRICE_VERSION=openai-gpt-5.6-terra-standard-2026-08-07
AI_REQUIRE_PRICING_FOR_REQUESTS=true
# Explicit provider/model capabilities; override for the exact configured model.
AI_SUPPORTS_JSON_OBJECT=false
AI_SUPPORTS_JSON_SCHEMA=true
AI_SUPPORTS_STRICT_SCHEMA=true
AI_SUPPORTS_TEMPERATURE=false
AI_SUPPORTS_MAX_TOKENS=false
AI_SUPPORTS_MAX_COMPLETION_TOKENS=false
AI_SUPPORTS_MAX_OUTPUT_TOKENS=true
AI_SUPPORTS_USAGE_REPORTING=true
AI_SUPPORTS_REQUEST_ID=true
AI_SUPPORTS_REASONING_MODELS=true
AI_SUPPORTS_RETRYABLE_IDEMPOTENT_REQUESTS=false
AI_REASONING_EFFORT=low
AI_CERTIFICATION_MAX_TOKENS=1200
AI_CERTIFICATION_TTL_HOURS=24
AI_CERTIFICATION_REPEAT_SUPPRESSION_SECONDS=60
AI_PROMOTION_MIN_SHADOW_DECISIONS=30
AI_PROMOTION_MIN_ASSIST_DECISIONS=100
AI_PROMOTION_MIN_SCHEMA_VALID_RATE=0.99
AI_PROMOTION_MIN_SEMANTIC_VALID_RATE=0.95
AI_PROMOTION_MAX_TRANSPORT_FAILURE_RATE=0.05
